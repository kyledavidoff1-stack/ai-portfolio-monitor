# ─────────────────────────────────────────────────────────────────────────────
# Everything here is optional — you can configure keys on the Settings page
# instead (they are stored in your local database). A value set in the app
# takes precedence over these; clear it there to fall back to this file.
# ─────────────────────────────────────────────────────────────────────────────

# Financial Modeling Prep — prices, statements, profiles, peers
# Get yours at: https://financialmodelingprep.com/developer
# Free tier: 250 requests/day. Starter ($14/month) removes the limits that
# otherwise show up as missing panels.
FMP_API_KEY=your_fmp_api_key_here

# AI provider — the analysis pipeline speaks the Anthropic Messages API.
# Your own Anthropic key works directly (https://console.anthropic.com), and so
# does any gateway or proxy implementing the same API — set AI_BASE_URL for that.
# CLAUDE_API_KEY and ANTHROPIC_API_KEY are both accepted as fallbacks.
AI_API_KEY=your_api_key_here

# Model name your provider expects.
AI_MODEL=claude-sonnet-4-6

# Optional. Leave unset for the Anthropic API; set it to point at a gateway,
# proxy, or self-hosted endpoint that speaks the same API.
# AI_BASE_URL=https://your-gateway.example.com

# Analysis settings
SCAN_ANOMALY_THRESHOLD=0.02        # 2% divergence from expected return triggers flag
SCAN_PRICE_SPIKE_THRESHOLD=0.02    # 2% intraday move triggers delta re-scan
CACHE_NEWS_HOURS=4                 # Hours before news/sentiment cache expires
CACHE_FUNDAMENTALS_HOURS=24        # Hours before fundamental data cache expires
CACHE_CATALYSTS_HOURS=12           # Hours before catalyst scan cache expires

# Database path (relative to project root)
DATABASE_URL=./data/portfolio.db
